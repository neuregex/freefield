{
  "$schema": "../../schema/app.schema.json",
  "id": "mixed-media",
  "name": "Mixed Media",
  "section": "video",
  "pack": "video-ltx25",
  "status": "ready",
  "higgsfield_feature": "Mixed Media",
  "summary": "Restyles a clip in one of 16 looks: FLUX 3 Klein redraws the first frame in the look, and the clip's edges keep its structure (Union Control IC-LoRA).",
  "workflow": "workflow.api.json",
  "source": {
    "template": "ComfyUI-LTXVideo example_workflows/2.5/LTX-2.5_ICLoRA_Union_Control_Distilled.json (44c8a36) + comfyui_workflow_templates image_flux3_klein_distilled_image_edit.json (0.1.115)",
    "comfyui": "0.42.0",
    "notes": "Gemma API text encoder removed (local encoding only), int8 weights, prompt enhancer removed. The example's annotators (Video Depth Anything, DWPose, Canny: all custom nodes) are replaced by the core Canny node on the edge branch. The example's optional first frame is always on and comes from the `edit` pipeline merged into the graph (nodes edit:*): the clip's first frame redrawn in the look. The first lab run with the look only in the prompt gave photoreal footage back in 14 of 16 looks; with the still, the look held only on the first second at LoRA strength 1.0 and to the last frame at 0.7 (run 20261023-124332-h100), which is the default. The LoRA was trained on LTX-2.3; Lightricks' own 2.5 example uses it."
  },
  "outputs": [
    {
      "node": "4852",
      "type": "video",
      "label": "Video"
    }
  ],
  "inputs": [
    {
      "id": "clip",
      "type": "video",
      "label": "Your clip",
      "required": true,
      "limits": {
        "max_mb": 200,
        "seconds": [
          2,
          8
