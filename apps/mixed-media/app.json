      "bind": [
        {
          "node": "5001",
          "field": "file"
        }
      ]
    },
    {
      "id": "style",
      "type": "select",
      "label": "Look",
      "default": "anime",
      "gallery": true,
      "options": [
        {
          "value": "anime",
          "label": "Anime",
          "sets": [
            {
              "node": "ff_style",
              "field": "value",
              "value": "Japanese anime style, cel shading, clean line art, vibrant flat colors"
