{
  "$schema": "../../schema/app.schema.json",
  "id": "inpaint",
  "name": "Inpaint",
  "section": "image",
  "summary": "Paint over the part of a photo to change and describe the change; FLUX 3 Image Klein redraws only what you painted.",
  "higgsfield_feature": "Inpaint",
  "pack": "image-flux3",
  "status": "ready",
  "workflow": "workflow.api.json",
  "source": {
    "template": "image_flux3_klein_distilled_image_edit.json",
    "comfyui": "0.42.0",
    "notes": "apps/edit's pipeline with a noise mask: photo and painted mask (the web UI's brush, white on black) go to 1 MP at the same size, the sampler starts from the encoded photo with SetLatentNoiseMask on the painted area grown 8 px, the photo is the reference, and ImageCompositeMasked pastes the result back through the same mask, so the rest of the photo keeps its pixels."
  },
  "inputs": [
    {
      "id": "image",
      "type": "image",
      "label": "Photo",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "11",
          "field": "image"
        }
      ]
    },
    {
      "id": "mask",
      "type": "image",
      "label": "Area to change",
      "required": true,
      "paint": "image",
      "limits": {
        "max_mb": 20
      },
      "help": "Paint over the photo; only that area is redrawn.",
      "bind": [
        {
          "node": "12",
          "field": "image"
        }
      ]
    },
    {
      "id": "instruction",
      "type": "textarea",
      "label": "What goes there",
      "required": true,
      "default": "a red leather jacket",
      "bind": [
        {
          "node": "4",
          "field": "text",
          "template": "{instruction}. Keep the rest of the image exactly the same."
        }
      ]
    },
    {
      "id": "steps",
      "type": "slider",
      "label": "Steps",
      "min": 8,
      "max": 30,
      "step": 1,
      "default": 16,
      "bind": [
        {
          "node": "7",
          "field": "steps"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "7",
          "field": "seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "9",
      "type": "image",
      "label": "Result"
    }
  ],
  "models": [
    {
      "repo": "black-forest-labs/flux-3-image-klein-comfy",
      "file": "diffusion_models/flux3-image-klein-int8-convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 5.83,
      "phase": "denoise",
      "gated": true,
      "license": "FLUX Kommunity License"
    },
    {
      "repo": "black-forest-labs/flux-3-image-klein-comfy",
      "file": "text_encoders/qwen3vl_4b_int8_convrot.safetensors",
      "dir": "text_encoders",
      "gb": 4.86,
      "phase": "encode",
      "gated": true,
      "license": "FLUX Kommunity License"
    },
    {
      "repo": "black-forest-labs/flux-3-image-klein-comfy",
      "file": "vae/flux2-vae.safetensors",
      "dir": "vae",
      "gb": 0.34,
      "phase": "decode",
      "gated": true,
      "license": "FLUX Kommunity License"
    }
  ],
  "credits": [
    "FLUX 3 Image Klein by Black Forest Labs (FLUX Kommunity License)"
  ],
  "test": {
    "image": "test/portrait.png",
    "mask": "test/second.png",
    "instruction": "a red scarf"
  }
}
