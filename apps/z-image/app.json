{
  "$schema": "../../schema/app.schema.json",
  "id": "z-image",
  "name": "Z-Image Turbo",
  "section": "image",
  "pack": "image",
  "status": "ready",
  "higgsfield_feature": "Create Image",
  "summary": "Fast text to image with Z-Image Turbo, 8 steps; the lab makes its reference photos with it.",
  "workflow": "workflow.api.json",
  "source": {
    "template": "image_z_image_turbo_int8.json",
    "comfyui": "0.42.0"
  },
  "inputs": [
    {
      "id": "prompt",
      "type": "textarea",
      "label": "Prompt",
      "required": true,
      "default": "A rainy neon street in Mexico City at night, cinematic, 35mm",
      "bind": [
        {
          "node": "57:27",
          "field": "text"
        }
      ]
    },
    {
      "id": "width",
      "type": "select",
      "label": "Width",
      "default": 1024,
      "options": [
        {
          "value": 768,
          "label": "768"
        },
        {
          "value": 1024,
          "label": "1024"
        },
        {
          "value": 1280,
          "label": "1280"
        },
        {
          "value": 1536,
          "label": "1536"
        }
      ],
      "bind": [
        {
          "node": "57:13",
          "field": "width"
        }
      ]
    },
    {
      "id": "height",
      "type": "select",
      "label": "Height",
      "default": 1024,
      "options": [
        {
          "value": 768,
          "label": "768"
        },
        {
          "value": 1024,
          "label": "1024"
        },
        {
          "value": 1280,
          "label": "1280"
        },
        {
          "value": 1536,
          "label": "1536"
        }
      ],
      "bind": [
        {
          "node": "57:13",
          "field": "height"
        }
      ]
    },
    {
      "id": "steps",
      "type": "slider",
      "label": "Steps",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8,
      "bind": [
        {
          "node": "57:3",
          "field": "steps"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "57:3",
          "field": "seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "9",
      "type": "image",
      "label": "Image"
    }
  ],
  "models": [
    {
      "repo": "Comfy-Org/z_image_turbo",
      "file": "split_files/diffusion_models/z_image_turbo_int8_convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 6.2,
      "phase": "denoise",
      "license": "Apache-2.0"
    },
    {
      "repo": "Comfy-Org/z_image_turbo",
      "file": "split_files/text_encoders/qwen_3_4b_fp8_mixed.safetensors",
      "dir": "text_encoders",
      "gb": 5.63,
      "phase": "encode",
      "license": "Apache-2.0"
    },
    {
      "repo": "Comfy-Org/z_image_turbo",
      "file": "split_files/vae/ae.safetensors",
      "dir": "vae",
      "gb": 0.34,
      "phase": "decode",
      "license": "Apache-2.0"
    }
  ],
  "credits": [
    "Z-Image Turbo by Tongyi-MAI (Apache-2.0)"
  ],
  "test": {
    "prompt": "a red bicycle against a white wall"
  }
}
