{
  "$schema": "../../schema/app.schema.json",
  "id": "vfx-clean-plate",
  "name": "Clean Plate",
  "section": "video",
  "pack": "video-ltx25",
  "status": "draft",
  "higgsfield_feature": "VFX: remove people",
  "summary": "Removes people and moving subjects from a shot and rebuilds the background.",
  "workflow": "workflow.api.json",
  "source": {
    "template": "ComfyUI-LTXVideo example_workflows/2.5/LTX-2.5_V2V_ICLoRA_Single_Stage_Distilled.json (44c8a36)",
    "comfyui": "0.42.0",
    "notes": "Gemma API text encoder removed (local encoding only), int8 weights, first frame taken from the clip. Describe the empty scene, not the removal."
  },
  "inputs": [
    {
      "id": "clip",
      "type": "video",
      "label": "Your clip",
      "required": true,
      "limits": {
        "max_mb": 200,
        "seconds": [
          2,
          8
        ]
      },
      "bind": [
        {
          "node": "5001",
          "field": "file"
        }
      ]
    },
    {
      "id": "prompt",
      "type": "textarea",
      "label": "Describe the result",
      "required": true,
      "default": "An empty city street with parked cars and shop fronts, no people anywhere in the frame, natural daylight.",
      "bind": [
        {
          "node": "5508",
          "field": "value"
        }
      ]
    },
    {
      "id": "negative",
      "type": "textarea",
      "label": "Must not appear",
      "default": "people, pedestrians, person, crowd",
      "bind": [
        {
          "node": "5509",
          "field": "value"
        }
      ]
    },
    {
      "id": "strength",
      "type": "slider",
      "label": "Strength",
      "min": 0.5,
      "max": 1.3,
      "step": 0.05,
      "default": 1.0,
      "bind": [
        {
          "node": "5004:5606",
          "field": "strength_model"
        }
      ]
    },
    {
      "id": "size",
      "type": "select",
      "label": "Resolution (short side)",
      "default": 544,
      "options": [
        {
          "value": 448,
          "label": "448 px"
        },
        {
          "value": 544,
          "label": "544 px"
        },
        {
          "value": 576,
          "label": "576 px"
        },
        {
          "value": 720,
          "label": "720 px"
        }
      ],
      "bind": [
        {
          "node": "5548:5026",
          "field": "resize_type.shorter_size"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "5516:4832",
          "field": "noise_seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "4852",
      "type": "video",
      "label": "Result"
    }
  ],
  "models": [
    {
      "repo": "Lightricks/LTX-2.5",
      "file": "diffusion_models/ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 21.5,
      "phase": "denoise",
      "gated": true,
      "license": "LTX-2.x Community License"
    },
    {
      "repo": "Lightricks/LTX-2.5",
      "file": "text_encoders/gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
      "dir": "text_encoders",
      "gb": 15.37,
      "phase": "encode",
      "gated": true,
      "license": "LTX-2.x Community License"
    },
    {
      "repo": "Lightricks/LTX-2.5",
      "file": "vae/ltx-2.5-video-vae-bf16.safetensors",
      "dir": "vae",
      "gb": 1.47,
      "phase": "decode",
      "gated": true,
      "license": "LTX-2.x Community License"
    },
    {
      "repo": "Lightricks/LTX-2.5",
      "file": "vae/ltx-2.5-audio-vae-bf16.safetensors",
      "dir": "vae",
      "gb": 0.36,
      "phase": "decode",
      "gated": true,
      "license": "LTX-2.x Community License"
    },
    {
      "repo": "Comfy-Org/gemma-4",
      "file": "text_encoders/gemma4_e2b_it_int8_convrot.safetensors",
      "dir": "text_encoders",
      "gb": 5.2,
      "phase": "encode",
      "license": "Apache-2.0",
      "optional": true
    },
    {
      "repo": "Lightricks/LTX-2.5-22b-IC-LoRA-Clean-Plate",
      "file": "ltx-2.5-22b-ic-lora-clean-plate-1.0.safetensors",
      "dir": "loras",
      "gb": 0.33,
      "phase": "denoise",
      "gated": true,
      "license": "LTX-2.x Community License"
    }
  ],
  "custom_nodes": [
    {
      "repo": "https://github.com/Lightricks/ComfyUI-LTXVideo",
      "commit": "44c8a36b7c31ee00b4271daed11dc2a4aa481140"
    }
  ],
  "credits": [
    "LTX-2.5 and IC-LoRA by Lightricks",
    "Workflow adapted from Lightricks' ComfyUI-LTXVideo examples"
  ],
  "test": {
    "clip": "test/clip.mp4",
    "size": 448
  }
}
