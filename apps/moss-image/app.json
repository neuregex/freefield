{
  "$schema": "../../schema/app.schema.json",
  "id": "moss-image",
  "name": "Layout Image",
  "section": "image",
  "pack": "image-moss",
  "status": "draft",
  "higgsfield_feature": "Create Image",
  "summary": "Text to image with MOSS-Image (Apache-2.0); also takes a layout JSON that places each text and object in its own box.",
  "workflow": "workflow.api.json",
  "source": {
    "template": "image_moss_image_t2i.json",
    "comfyui": "0.42.0",
    "notes": "MOSS-Image SFT, int8. Its Qwen3.5-9B text encoder also rewrites a short prompt into a caption. A layout prompt is the JSON MOSSImageLayoutPrompt writes: {\"summary\": {\"caption\": ...}, \"items\": [{\"label\": \"text\"|\"object\"|\"character\", \"caption\": ..., \"text\": ..., \"bbox\": [y0, x0, y1, x1]}], \"bbox_coord_space\": \"abs_centralized\", \"bbox_format\": \"yxyx\"} (pixels, origin at the centre); turn the rewrite off for it."
  },
  "inputs": [
    {
      "id": "prompt",
      "type": "textarea",
      "label": "Prompt or layout JSON",
      "required": true,
      "default": "A minimalist concert poster: the title \"MIDNIGHT TACOS\" in huge bold letters at the top, \"LIVE · FRIDAY 9 PM\" below it, a neon taco truck at night, risograph print, hot pink and teal",
      "bind": [
        {
          "node": "18:17",
          "field": "value"
        }
      ]
    },
    {
      "id": "rewrite",
      "type": "toggle",
      "label": "Rewrite my prompt",
      "default": true,
      "help": "MOSS-Image's own text encoder turns a short prompt into a detailed caption. Turn it off for a layout JSON.",
      "bind": [
        {
          "node": "18:16",
          "field": "switch"
        }
      ]
    },
    {
      "id": "width",
      "type": "select",
      "label": "Width",
      "default": 1024,
      "options": [
        {
          "value": 768,
          "label": "768"
        },
        {
          "value": 1024,
          "label": "1024"
        },
        {
          "value": 1280,
          "label": "1280"
        },
        {
          "value": 1536,
          "label": "1536"
        }
      ],
      "bind": [
        {
          "node": "18:6",
          "field": "width"
        }
      ]
    },
    {
      "id": "height",
      "type": "select",
      "label": "Height",
      "default": 1024,
      "options": [
        {
          "value": 768,
          "label": "768"
        },
        {
          "value": 1024,
          "label": "1024"
        },
        {
          "value": 1280,
          "label": "1280"
        },
        {
          "value": 1536,
          "label": "1536"
        }
      ],
      "bind": [
        {
          "node": "18:6",
          "field": "height"
        }
      ]
    },
    {
      "id": "steps",
      "type": "slider",
      "label": "Steps",
      "min": 20,
      "max": 60,
      "step": 1,
      "default": 25,
      "bind": [
        {
          "node": "18:7",
          "field": "steps"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "18:7",
          "field": "seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "9",
      "type": "image",
      "label": "Image"
    }
  ],
  "models": [
    {
      "repo": "Comfy-Org/MOSS-Image",
      "file": "diffusion_models/moss_image_sft_int8_convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 5.41,
      "phase": "denoise",
      "license": "Apache-2.0"
    },
    {
      "repo": "Comfy-Org/MOSS-Image",
      "file": "text_encoders/qwen3.5_9b_w4a8_gptq.safetensors",
      "dir": "text_encoders",
      "gb": 7.34,
      "phase": "encode",
      "license": "Apache-2.0"
    },
    {
      "repo": "Comfy-Org/MOSS-Image",
      "file": "vae/flux2-vae_small.safetensors",
      "dir": "vae",
      "gb": 0.25,
      "phase": "decode",
      "license": "Apache-2.0"
    }
  ],
  "credits": [
    "MOSS-Image by OpenMOSS (Apache-2.0)"
  ],
  "test": {
    "prompt": "a red bicycle against a white wall",
    "rewrite": false
  }
}
