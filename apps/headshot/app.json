{
  "$schema": "../../schema/app.schema.json",
  "id": "headshot",
  "name": "Studio Headshot",
  "section": "image",
  "summary": "A professional studio headshot from one selfie: backdrop and outfit of your choice.",
  "higgsfield_feature": "AI Headshot Generator",
  "pack": "image-flux3",
  "status": "ready",
  "workflow": "workflow.api.json",
  "source": {
    "template": "image_flux3_klein_distilled_image_edit.json",
    "comfyui": "0.42.0",
    "notes": "Template app written by tools/template_apps.py: the workflow is apps/edit's (built by tools/build_apps.py) and the prompt below is fixed; \"Extra direction\" is appended to it."
  },
  "inputs": [
    {
      "id": "image",
      "type": "image",
      "label": "Your selfie",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "11",
          "field": "image"
        }
      ]
    },
    {
      "id": "backdrop",
      "type": "select",
      "label": "Backdrop",
      "default": "plain light grey backdrop",
      "options": [
        {
          "value": "plain light grey backdrop",
          "label": "Light grey"
        },
        {
          "value": "dark charcoal backdrop",
          "label": "Dark charcoal"
        },
        {
          "value": "in a bright office with blurred windows",
          "label": "Office, blurred"
        },
        {
          "value": "outdoors with golden-hour bokeh",
          "label": "Outdoor bokeh"
        }
      ]
    },
    {
      "id": "outfit",
      "type": "select",
      "label": "Outfit",
      "default": "a navy blazer over a white shirt",
      "options": [
        {
          "value": "a navy blazer over a white shirt",
          "label": "Navy blazer"
        },
        {
          "value": "a black turtleneck",
          "label": "Black turtleneck"
        },
        {
          "value": "a light linen shirt",
          "label": "Linen shirt"
        },
        {
          "value": "the same clothes as in the photo",
          "label": "As in the photo"
        }
      ]
    },
    {
      "id": "details",
      "type": "textarea",
      "label": "Extra direction",
      "default": "",
      "help": "Added at the end of the app's prompt.",
      "bind": [
        {
          "node": "4",
          "field": "text",
          "template": "A professional studio headshot of the same person as in <ref_image_0>, {backdrop}, wearing {outfit}, soft three-point lighting, sharp focus on the eyes, shoulders-up framing. Keep the face, hairstyle and build identical. {details}"
        }
      ]
    },
    {
      "id": "steps",
      "type": "slider",
      "label": "Steps",
      "min": 8,
      "max": 32,
      "step": 1,
      "default": 16,
      "bind": [
        {
          "node": "7",
          "field": "steps"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "7",
          "field": "seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "9",
      "type": "image",
      "label": "Result"
    }
  ],
  "models": [
    {
      "repo": "black-forest-labs/flux-3-image-klein-comfy",
      "file": "diffusion_models/flux3-image-klein-int8-convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 5.83,
      "phase": "denoise",
      "gated": true,
      "license": "FLUX Kommunity License"
    },
    {
      "repo": "black-forest-labs/flux-3-image-klein-comfy",
      "file": "text_encoders/qwen3vl_4b_int8_convrot.safetensors",
      "dir": "text_encoders",
      "gb": 4.86,
      "phase": "encode",
      "gated": true,
      "license": "FLUX Kommunity License"
    },
    {
      "repo": "black-forest-labs/flux-3-image-klein-comfy",
      "file": "vae/flux2-vae.safetensors",
      "dir": "vae",
      "gb": 0.34,
      "phase": "decode",
      "gated": true,
      "license": "FLUX Kommunity License"
    }
  ],
  "credits": [
    "FLUX 3 Image Klein by Black Forest Labs (FLUX Kommunity License)"
  ],
  "test": {
    "image": "test/portrait.png"
  }
}
