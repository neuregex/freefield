{
  "$schema": "../../schema/app.schema.json",
  "id": "roller-coaster",
  "name": "Roller Coaster",
  "section": "video",
  "summary": "You on a roller coaster: the photo turns into the ride, same face.",
  "higgsfield_feature": "Roller Coaster",
  "pack": "video-ltx25",
  "status": "ready",
  "workflow": "workflow.api.json",
  "source": {
    "template": "comfyui_workflow_templates video_ltx2_5_flf2v.json (0.1.115) + image_flux3_klein_distilled_image_edit.json",
    "comfyui": "0.42.0",
    "notes": "Template app written by tools/template_apps.py: the workflow is apps/morph's (built by tools/build_apps.py) with a fixed Klein instruction for the last frame (node edit:4: \"Put this exact person in the front seat of a roller coaster car at the top of the first drop: a padded safety bar across the chest, hands in the air, hair blown back, a wide excited grin, the camera mounted on the car facing them, blue sky and the steel track behind. Keep the face identical.\"); the prompt below is fixed and \"Extra direction\" is appended to it."
  },
  "inputs": [
    {
      "id": "image",
      "type": "image",
      "label": "Your photo",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "31",
          "field": "image"
        }
      ]
    },
    {
      "id": "details",
      "type": "textarea",
      "label": "Extra direction",
      "default": "",
      "help": "Added at the end of the app's prompt.",
      "bind": [
        {
          "node": "251:252",
          "field": "value",
          "template": "The scene turns into a roller coaster ride: the car crests the top and drops, the person screams with joy, hands up, hair whipping, the track rushing behind; clattering track and wind. {details}"
        }
      ]
    },
    {
      "id": "aspect",
      "type": "select",
      "label": "Format",
      "default": "portrait",
      "options": [
        {
          "value": "portrait",
          "label": "9:16",
          "sets": [
            {
              "node": "251:215",
              "field": "value",
              "value": 720
            },
            {
              "node": "251:216",
              "field": "value",
              "value": 1280
            }
          ]
        },
        {
          "value": "landscape",
          "label": "16:9",
          "sets": [
            {
              "node": "251:215",
              "field": "value",
              "value": 1280
            },
            {
              "node": "251:216",
              "field": "value",
              "value": 720
            }
          ]
        },
        {
          "value": "square",
          "label": "1:1",
          "sets": [
            {
              "node": "251:215",
              "field": "value",
              "value": 960
            },
            {
              "node": "251:216",
              "field": "value",
              "value": 960
            }
          ]
        }
      ]
    },
    {
      "id": "duration",
      "type": "slider",
      "label": "Seconds",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "bind": [
        {
          "node": "251:198",
          "field": "value"
        }
      ]
    },
    {
      "id": "strength",
      "type": "slider",
      "label": "Transition strength",
      "min": 0,
      "max": 1.5,
      "step": 0.05,
      "default": 1.0,
      "bind": [
        {
          "node": "ff_lora",
          "field": "strength_model"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "251:196",
          "field": "noise_seed"
        },
        {
          "node": "edit:7",
          "field": "seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "68",
      "type": "video",
      "label": "Result"
    }
  ],
  "models": [
