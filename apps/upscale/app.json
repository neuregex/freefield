{
  "$schema": "../../schema/app.schema.json",
  "id": "upscale",
  "name": "Upscale Image",
  "section": "image",
  "pack": "upscale",
  "status": "ready",
  "higgsfield_feature": "Image Upscale",
  "summary": "SeedVR2 restores detail while enlarging 2× or 4×.",
  "workflow": "workflow.api.json",
  "source": {
    "template": "utility_seedvr2_3b_int8_upscale_image.json",
    "comfyui": "0.42.0"
  },
  "inputs": [
    {
      "id": "image",
      "type": "image",
      "label": "Image",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "1",
          "field": "image"
        }
      ]
    },
    {
      "id": "scale",
      "type": "select",
      "label": "Scale",
      "default": 2,
      "options": [
        {
          "value": 2,
          "label": "2×"
        },
        {
          "value": 4,
          "label": "4×"
        }
      ],
      "bind": [
        {
          "node": "66:57",
          "field": "resize_type.multiplier"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "66:54",
          "field": "seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "9",
      "type": "image",
      "label": "Upscaled"
    }
  ],
  "models": [
    {
      "repo": "Comfy-Org/SeedVR2",
      "file": "diffusion_models/seedvr2_3b_int8_convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 3.46,
      "phase": "denoise",
      "license": "Apache-2.0"
    },
    {
      "repo": "Comfy-Org/SeedVR2",
      "file": "vae/seedvr2_ema_vae_fp16.safetensors",
      "dir": "vae",
      "gb": 0.5,
      "phase": "decode",
      "license": "Apache-2.0"
    }
  ],
  "credits": [
    "SeedVR2 by ByteDance Seed (Apache-2.0)"
  ],
  "test": {
    "image": "test/portrait.png",
    "scale": 2
  }
}
