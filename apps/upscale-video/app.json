{
  "$schema": "../../schema/app.schema.json",
  "id": "upscale-video",
  "name": "Upscale Video",
  "section": "video",
  "pack": "upscale",
  "status": "ready",
  "higgsfield_feature": "Video Upscale",
  "summary": "SeedVR2 restores and doubles the resolution of a clip.",
  "workflow": "workflow.api.json",
  "source": {
    "template": "utility_seedvr2_3b_int8_upscale_video.json",
    "comfyui": "0.42.0"
  },
  "inputs": [
    {
      "id": "clip",
      "type": "video",
      "label": "Clip",
      "required": true,
      "limits": {
        "max_mb": 200,
        "seconds": [
          1,
          20
        ]
      },
      "bind": [
        {
          "node": "73",
          "field": "file"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "66:54",
          "field": "seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "76",
      "type": "video",
      "label": "Upscaled"
    }
  ],
  "models": [
    {
      "repo": "Comfy-Org/SeedVR2",
      "file": "diffusion_models/seedvr2_3b_int8_convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 3.46,
      "phase": "denoise",
      "license": "Apache-2.0"
    },
    {
      "repo": "Comfy-Org/SeedVR2",
      "file": "vae/seedvr2_ema_vae_fp16.safetensors",
      "dir": "vae",
      "gb": 0.5,
      "phase": "decode",
      "license": "Apache-2.0"
    }
  ],
  "credits": [
    "SeedVR2 by ByteDance Seed (Apache-2.0)"
  ],
  "test": {
    "clip": "test/clip.mp4"
  }
}
