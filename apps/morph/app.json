      "min": 0,
      "max": 1.5,
      "step": 0.05,
      "default": 1.0,
      "bind": [
        {
          "node": "ff_lora",
          "field": "strength_model"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
