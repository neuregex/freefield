    }
  ],
  "credits": [
    "Effect LoRAs by Remade-AI (Apache-2.0)",
    "Bullet time, Money rain and Clones LoRAs by joyfox (Apache-2.0; the repos moved there from valiantcat and laozou)",
    "Dolly zoom LoRA by ostris (Apache-2.0)",
    "Steam LoRA by lvfengchun (Apache-2.0)",
    "Wan 2.1 image-to-video 14B by Wan-AI, Alibaba (Apache-2.0)",
    "Step-distill LoRA by lightx2v, packaged for ComfyUI by Kijai",
    "Workflow: ComfyUI official template",
    "FLUX 3 Image Klein by Black Forest Labs (FLUX Kommunity License)"
  ],
  "test": {
    "image": "test/portrait.png",
    "duration": 2,
    "subject": "a sprinter in a red and white running outfit"
  }
}
