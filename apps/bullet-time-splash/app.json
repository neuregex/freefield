      "license": "Apache-2.0",
      "optional": true
    },
    {
      "repo": "joyfox/Wan2.1-BulletTime-LoRA",
      "file": "Wan21_I2V_rotation_000003750.safetensors",
      "dir": "loras",
      "gb": 0.36,
      "phase": "denoise",
      "license": "Apache-2.0",
      "optional": true
    },
    {
      "repo": "black-forest-labs/flux-3-image-klein-comfy",
      "file": "diffusion_models/flux3-image-klein-int8-convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 5.83,
