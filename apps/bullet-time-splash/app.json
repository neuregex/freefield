      "gb": 6.74,
      "phase": "encode",
      "license": "Apache-2.0"
    },
    {
      "repo": "Comfy-Org/Wan_2.1_ComfyUI_repackaged",
      "file": "split_files/clip_vision/clip_vision_h.safetensors",
      "dir": "clip_vision",
      "gb": 1.26,
      "phase": "encode",
      "license": "Apache-2.0"
    },
    {
      "repo": "Comfy-Org/Wan_2.1_ComfyUI_repackaged",
