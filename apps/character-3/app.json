{
  "$schema": "../../schema/app.schema.json",
  "id": "character-3",
  "name": "Character (3 Photos)",
  "section": "image",
  "summary": "The person from three of your photos in a new scene: more angles of one face keep the likeness closer (FLUX 3 Image Klein).",
  "higgsfield_feature": "Soul ID",
  "pack": "image-flux3",
  "status": "ready",
  "workflow": "workflow.api.json",
  "source": {
    "template": "image_flux3_klein_distilled_image_edit.json",
    "comfyui": "0.42.0",
    "notes": "apps/edit's pipeline with three LoadImage nodes on ReferenceMultiLatent (images.image0-2, 1 MP each) and an empty latent of its own (aspect ratio and resolution as in create-image). Higgsfield's Soul ID trains on the photos; this keeps them as references instead."
  },
  "inputs": [
    {
      "id": "photo1",
      "type": "image",
      "label": "Photo 1",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "help": "Three photos of the same person: front, three-quarter, another light or day.",
      "bind": [
        {
          "node": "11",
          "field": "image"
        }
      ]
    },
    {
      "id": "photo2",
      "type": "image",
      "label": "Photo 2",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "12",
          "field": "image"
        }
      ]
    },
    {
      "id": "photo3",
      "type": "image",
      "label": "Photo 3",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "13",
          "field": "image"
        }
      ]
    },
    {
      "id": "scene",
      "type": "textarea",
      "label": "Scene",
      "required": true,
      "default": "ordering a coffee at a café counter, morning light",
      "bind": [
        {
          "node": "4",
          "field": "text",
          "template": "The same person as in <ref_image_0>, <ref_image_1> and <ref_image_2> (three photos of one person), {scene}. Keep the face, hairstyle and build identical."
        }
      ]
    },
    {
      "id": "aspect",
      "type": "select",
      "label": "Aspect ratio",
      "default": "4:5",
      "help": "At 1K the image has about 1 megapixel in this shape; Resolution scales it.",
      "options": [
        {
          "value": "1:1",
          "label": "1:1",
          "sets": [
            {
              "node": "ff_size",
              "field": "width",
              "value": 1024
            },
            {
              "node": "ff_size",
              "field": "height",
              "value": 1024
            }
          ]
        },
        {
          "value": "4:3",
          "label": "4:3",
          "sets": [
            {
              "node": "ff_size",
              "field": "width",
              "value": 1152
            },
            {
              "node": "ff_size",
              "field": "height",
              "value": 864
            }
          ]
        },
        {
          "value": "3:4",
          "label": "3:4",
          "sets": [
            {
              "node": "ff_size",
              "field": "width",
              "value": 864
            },
            {
              "node": "ff_size",
              "field": "height",
              "value": 1152
            }
          ]
        },
        {
          "value": "3:2",
          "label": "3:2",
          "sets": [
            {
              "node": "ff_size",
              "field": "width",
              "value": 1248
            },
            {
              "node": "ff_size",
              "field": "height",
              "value": 832
            }
          ]
        },
        {
          "value": "2:3",
          "label": "2:3",
          "sets": [
            {
              "node": "ff_size",
              "field": "width",
              "value": 832
            },
            {
              "node": "ff_size",
              "field": "height",
              "value": 1248
            }
          ]
        },
        {
          "value": "5:4",
          "label": "5:4",
          "sets": [
            {
              "node": "ff_size",
              "field": "width",
              "value": 1120
            },
            {
              "node": "ff_size",
              "field": "height",
              "value": 896
            }
          ]
        },
        {
          "value": "4:5",
          "label": "4:5",
          "sets": [
            {
              "node": "ff_size",
              "field": "width",
              "value": 896
            },
            {
              "node": "ff_size",
              "field": "height",
              "value": 1120
            }
          ]
        },
        {
          "value": "16:9",
          "label": "16:9",
          "sets": [
            {
              "node": "ff_size",
              "field": "width",
              "value": 1344
            },
            {
              "node": "ff_size",
              "field": "height",
              "value": 768
            }
          ]
        },
        {
          "value": "9:16",
          "label": "9:16",
          "sets": [
            {
              "node": "ff_size",
              "field": "width",
              "value": 768
            },
            {
              "node": "ff_size",
              "field": "height",
              "value": 1344
            }
          ]
        },
        {
          "value": "21:9",
          "label": "21:9",
          "sets": [
            {
              "node": "ff_size",
              "field": "width",
              "value": 1536
            },
            {
              "node": "ff_size",
              "field": "height",
              "value": 640
            }
          ]
        }
      ],
      "bind": []
    },
    {
      "id": "resolution",
      "type": "select",
      "label": "Resolution",
      "default": 1,
      "help": "1K is about 1 megapixel; 2K is four times the pixels and takes about four times as long.",
      "options": [
        {
          "value": 1,
          "label": "1K"
        },
        {
          "value": 1.5,
          "label": "1.5K"
        },
        {
          "value": 2,
          "label": "2K"
        }
      ],
      "bind": [
        {
          "node": "ff_res",
          "field": "scale_by"
        }
      ]
    },
    {
      "id": "steps",
      "type": "slider",
      "label": "Steps",
      "min": 8,
      "max": 30,
      "step": 1,
      "default": 16,
      "bind": [
        {
          "node": "7",
          "field": "steps"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "7",
          "field": "seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "9",
      "type": "image",
      "label": "Result"
    }
  ],
  "models": [
    {
      "repo": "black-forest-labs/flux-3-image-klein-comfy",
      "file": "diffusion_models/flux3-image-klein-int8-convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 5.83,
      "phase": "denoise",
