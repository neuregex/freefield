{
  "$schema": "../../schema/app.schema.json",
  "id": "reframe",
  "name": "Reframe",
  "section": "video",
  "pack": "video-ltx25",
  "status": "ready",
  "higgsfield_feature": "Reframe",
  "summary": "Changes a clip's aspect ratio by painting what lies beyond the frame, in two stages (Lightricks' In-Outpainting IC-LoRA).",
  "workflow": "workflow.api.json",
  "source": {
    "template": "ComfyUI-LTXVideo example_workflows/2.5/LTX-2.5_ICLoRA_Outpaint_Two_Stage_Distilled.json (44c8a36)",
    "comfyui": "0.42.0",
    "notes": "Gemma API text encoder removed (local encoding only), int8 weights, prompt enhancer and optional start image removed. The example's ImagePadForOutpaintTargetSize (KJNodes) is rebuilt from core nodes with the same arithmetic: fit the frames inside the target (never upscaled), pad centred, mask the padding. The clip is normalised to a 1024 px short side first, as in the example; the targets are the example's 1920×1088 scale. The LoRA was trained on LTX-2.3; Lightricks' own 2.5 example uses it. Not run yet."
  },
  "outputs": [
    {
      "node": "5228",
      "type": "video",
      "label": "Video"
    }
  ],
  "inputs": [
    {
      "id": "clip",
      "type": "video",
      "label": "Your clip",
      "required": true,
      "limits": {
        "max_mb": 200,
        "seconds": [
          2,
          8
        ]
