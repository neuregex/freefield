{
  "$schema": "../../schema/app.schema.json",
  "id": "edit",
  "name": "Edit Image",
  "section": "image",
  "pack": "image-flux3",
  "status": "ready",
  "higgsfield_feature": "Inpaint / Edit",
  "summary": "Describe a change and FLUX 3 Image Klein applies it to your photo.",
  "workflow": "workflow.api.json",
  "source": {
    "template": "image_flux3_klein_distilled_image_edit.json",
    "comfyui": "0.42.0",
    "notes": "Bounding-box layout tool and 9B prompt upsampler removed; the instruction goes straight to the text encoder."
  },
  "inputs": [
    {
      "id": "image",
      "type": "image",
      "label": "Photo",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "11",
          "field": "image"
        }
      ]
    },
    {
      "id": "instruction",
      "type": "textarea",
      "label": "What should change?",
      "required": true,
      "default": "Relight the scene with warm golden-hour sunlight from the left",
      "bind": [
        {
          "node": "4",
          "field": "text"
        }
      ]
    },
    {
      "id": "steps",
      "type": "slider",
      "label": "Steps",
      "min": 8,
      "max": 32,
      "step": 1,
      "default": 16,
      "bind": [
        {
          "node": "7",
          "field": "steps"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "7",
          "field": "seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "9",
      "type": "image",
      "label": "Edited"
    }
  ],
  "models": [
    {
      "repo": "black-forest-labs/flux-3-image-klein-comfy",
      "file": "diffusion_models/flux3-image-klein-int8-convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 5.83,
      "phase": "denoise",
      "gated": true,
      "license": "FLUX Kommunity License"
    },
    {
      "repo": "black-forest-labs/flux-3-image-klein-comfy",
      "file": "text_encoders/qwen3vl_4b_int8_convrot.safetensors",
      "dir": "text_encoders",
      "gb": 4.86,
      "phase": "encode",
      "gated": true,
      "license": "FLUX Kommunity License"
    },
    {
      "repo": "black-forest-labs/flux-3-image-klein-comfy",
      "file": "vae/flux2-vae.safetensors",
      "dir": "vae",
      "gb": 0.34,
      "phase": "decode",
      "gated": true,
      "license": "FLUX Kommunity License"
    }
  ],
  "credits": [
    "FLUX 3 Image Klein by Black Forest Labs (FLUX Kommunity License)"
  ],
  "test": {
    "image": "test/portrait.png",
    "instruction": "make the background a beach"
  }
}
