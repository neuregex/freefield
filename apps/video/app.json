{
  "$schema": "../../schema/app.schema.json",
  "id": "video",
  "name": "Image to Video",
  "section": "video",
  "pack": "video-ltx25",
  "status": "ready",
  "higgsfield_feature": "Create Video",
  "summary": "Animates a still into a shot with synchronized audio, two stages with LTX-2.5.",
  "workflow": "workflow.api.json",
  "source": {
    "template": "video_ltx2_5_i2v.json",
    "comfyui": "0.42.0"
  },
  "inputs": [
    {
      "id": "image",
      "type": "image",
      "label": "First frame",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "395",
          "field": "image"
        }
      ]
    },
    {
      "id": "prompt",
      "type": "textarea",
      "label": "Prompt",
      "required": true,
      "default": "The camera slowly pushes in as she turns her head toward the light, hair moving in the wind",
      "bind": [
        {
          "node": "398:376",
          "field": "value"
        }
      ]
    },
    {
      "id": "duration",
      "type": "slider",
      "label": "Seconds",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5,
      "bind": [
        {
          "node": "398:362",
          "field": "value"
        }
      ]
    },
    {
      "id": "enhance",
      "type": "toggle",
      "label": "Enhance prompt",
      "default": true,
      "help": "Rewrites your prompt with a small Gemma 4 model first",
      "bind": [
        {
          "node": "398:383",
          "field": "value"
        }
      ]
    },
    {
      "id": "aspect",
      "type": "select",
      "label": "Aspect ratio",
      "default": "16:9 (Widescreen)",
      "options": [
        {
          "value": "16:9 (Widescreen)",
          "label": "16:9"
        },
        {
          "value": "9:16 (Portrait Widescreen)",
          "label": "9:16"
        },
        {
          "value": "1:1 (Square)",
          "label": "1:1"
        },
        {
          "value": "4:3 (Standard)",
          "label": "4:3"
        },
        {
          "value": "3:4 (Portrait Standard)",
          "label": "3:4"
        },
        {
          "value": "21:9 (Ultrawide)",
          "label": "21:9"
        }
      ],
      "bind": [
        {
          "node": "403",
          "field": "aspect_ratio"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "398:339",
          "field": "noise_seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "75",
      "type": "video",
      "label": "Video"
    }
  ],
  "models": [
    {
      "repo": "Lightricks/LTX-2.5",
      "file": "diffusion_models/ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 21.5,
      "phase": "denoise",
      "gated": true,
      "license": "LTX-2.x Community License"
    },
    {
      "repo": "Lightricks/LTX-2.5",
      "file": "text_encoders/gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
      "dir": "text_encoders",
      "gb": 15.37,
      "phase": "encode",
      "gated": true,
      "license": "LTX-2.x Community License"
    },
    {
      "repo": "Lightricks/LTX-2.5",
      "file": "vae/ltx-2.5-video-vae-bf16.safetensors",
      "dir": "vae",
      "gb": 1.47,
      "phase": "decode",
      "gated": true,
      "license": "LTX-2.x Community License"
    },
    {
      "repo": "Lightricks/LTX-2.5",
      "file": "vae/ltx-2.5-audio-vae-bf16.safetensors",
      "dir": "vae",
      "gb": 0.36,
      "phase": "decode",
      "gated": true,
      "license": "LTX-2.x Community License"
    },
    {
      "repo": "Lightricks/LTX-2.5",
      "file": "latent_upscale_models/ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors",
      "dir": "latent_upscale_models",
      "gb": 1.0,
      "phase": "aux",
      "gated": true,
      "license": "LTX-2.x Community License"
    },
    {
      "repo": "Comfy-Org/gemma-4",
      "file": "text_encoders/gemma4_e2b_it_int8_convrot.safetensors",
      "dir": "text_encoders",
      "gb": 5.2,
      "phase": "encode",
      "license": "Apache-2.0",
      "optional": true
    }
  ],
  "credits": [
    "LTX-2.5 by Lightricks",
    "Workflow adapted from ComfyUI's official LTX-2.5 template"
  ],
  "test": {
    "image": "test/portrait.png",
    "prompt": "she smiles and looks at the camera",
    "duration": 2
  }
}
