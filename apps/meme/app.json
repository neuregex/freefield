{
  "$schema": "../../schema/app.schema.json",
  "id": "meme",
  "name": "Meme Generator",
  "section": "image",
  "summary": "A meme image from a scene and two captions (Z-Image Turbo).",
  "higgsfield_feature": "Meme Generator",
  "pack": "image",
  "status": "ready",
  "workflow": "workflow.api.json",
  "source": {
    "template": "image_z_image_turbo_int8.json",
    "comfyui": "0.42.0",
    "notes": "Template app written by tools/template_apps.py: the workflow is apps/z-image's (built by tools/build_apps.py) and the prompt below is fixed; \"Extra direction\" is appended to it."
  },
  "inputs": [
    {
      "id": "scene",
      "type": "textarea",
      "label": "Scene",
      "required": true,
      "default": "a cat staring at a laptop screen with a worried face"
    },
    {
      "id": "top",
      "type": "text",
      "label": "Top text",
      "default": "WHEN THE BUILD",
      "required": true
    },
    {
      "id": "bottom",
      "type": "text",
      "label": "Bottom text",
      "default": "PASSES ON FRIDAY",
      "required": true
    },
    {
      "id": "details",
      "type": "textarea",
      "label": "Extra direction",
      "help": "Added at the end of the app's prompt.",
      "bind": [
        {
          "node": "57:27",
          "field": "text",
          "template": "A meme image: {scene}. Bold white capital letters in a thick Impact-style font with a black outline read \"{top}\" at the top and \"{bottom}\" at the bottom of the image. {details}"
        }
      ]
    },
    {
      "id": "width",
      "type": "select",
      "label": "Width",
      "default": 1024,
      "options": [
        {
          "value": 768,
          "label": "768"
        },
        {
          "value": 1024,
          "label": "1024"
        },
        {
          "value": 1280,
          "label": "1280"
        },
        {
          "value": 1536,
          "label": "1536"
        }
      ],
      "bind": [
        {
          "node": "57:13",
          "field": "width"
        }
      ]
    },
    {
      "id": "height",
      "type": "select",
      "label": "Height",
      "default": 1024,
      "options": [
        {
          "value": 768,
          "label": "768"
        },
        {
          "value": 1024,
          "label": "1024"
        },
        {
          "value": 1280,
          "label": "1280"
        },
        {
          "value": 1536,
          "label": "1536"
        }
      ],
      "bind": [
        {
          "node": "57:13",
          "field": "height"
        }
      ]
    },
    {
      "id": "steps",
      "type": "slider",
      "label": "Steps",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8,
      "bind": [
        {
          "node": "57:3",
          "field": "steps"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "57:3",
          "field": "seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "9",
      "type": "image",
      "label": "Result"
    }
  ],
  "models": [
    {
      "repo": "Comfy-Org/z_image_turbo",
      "file": "split_files/diffusion_models/z_image_turbo_int8_convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 6.2,
      "phase": "denoise",
      "license": "Apache-2.0"
    },
    {
      "repo": "Comfy-Org/z_image_turbo",
      "file": "split_files/text_encoders/qwen_3_4b_fp8_mixed.safetensors",
      "dir": "text_encoders",
      "gb": 5.63,
      "phase": "encode",
      "license": "Apache-2.0"
    },
    {
      "repo": "Comfy-Org/z_image_turbo",
      "file": "split_files/vae/ae.safetensors",
      "dir": "vae",
      "gb": 0.34,
      "phase": "decode",
      "license": "Apache-2.0"
    }
  ],
  "credits": [
    "Z-Image Turbo by Tongyi-MAI (Apache-2.0)"
  ],
  "test": {
    "scene": "a golden retriever sitting at a desk in front of three monitors, looking proud",
    "top": "WHEN THE TESTS",
    "bottom": "PASS FIRST TRY"
  }
}
