{
  "$schema": "../../schema/app.schema.json",
  "id": "meme",
  "name": "Meme Generator",
  "section": "image",
  "summary": "A meme image from a scene and two captions (FLUX 3 Klein).",
  "higgsfield_feature": "Meme Generator",
  "pack": "image-flux3",
  "status": "ready",
  "workflow": "workflow.api.json",
  "source": {
    "template": "image_flux3_klein_distilled_t2i.json",
    "comfyui": "0.42.0",
    "notes": "Template app written by tools/template_apps.py: the workflow is apps/create-image's (built by tools/build_apps.py) without the 9B prompt upsampler (the prompt goes straight to the text encoder); the prompt below is fixed and \"Extra direction\" is appended to it."
  },
  "inputs": [
    {
      "id": "scene",
      "type": "textarea",
      "label": "Scene",
      "required": true,
      "default": "a cat staring at a laptop screen with a worried face"
    },
    {
      "id": "top",
      "type": "text",
      "label": "Top text",
      "default": "WHEN THE BUILD",
      "required": true
    },
    {
      "id": "bottom",
      "type": "text",
      "label": "Bottom text",
      "default": "PASSES ON FRIDAY",
      "required": true
    },
    {
      "id": "details",
      "type": "textarea",
      "label": "Extra direction",
      "default": "",
      "help": "Added at the end of the app's prompt.",
      "bind": [
        {
          "node": "18:17",
          "field": "value",
          "template": "A meme image: {scene}. Bold white capital letters in a thick Impact-style font with a black outline read \"{top}\" at the top and \"{bottom}\" at the bottom of the image. {details}"
        }
      ]
    },
    {
      "id": "width",
      "type": "select",
      "label": "Width",
      "default": 1024,
      "options": [
        {
          "value": 768,
          "label": "768"
        },
        {
          "value": 1024,
          "label": "1024"
        },
        {
          "value": 1280,
          "label": "1280"
        },
        {
          "value": 1536,
          "label": "1536"
        }
      ],
      "bind": [
        {
          "node": "18:6",
          "field": "width"
        }
      ]
    },
    {
      "id": "height",
      "type": "select",
      "label": "Height",
      "default": 1024,
      "options": [
        {
          "value": 768,
          "label": "768"
        },
        {
          "value": 1024,
          "label": "1024"
        },
        {
          "value": 1280,
          "label": "1280"
        },
        {
          "value": 1536,
          "label": "1536"
        }
      ],
      "bind": [
        {
          "node": "18:6",
          "field": "height"
        }
      ]
    },
    {
      "id": "steps",
      "type": "slider",
      "label": "Steps",
      "min": 8,
      "max": 24,
      "step": 1,
      "default": 15,
      "bind": [
        {
          "node": "18:7",
          "field": "steps"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "18:7",
          "field": "seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "9",
      "type": "image",
      "label": "Result"
    }
  ],
  "models": [
    {
      "repo": "black-forest-labs/flux-3-image-klein-comfy",
      "file": "diffusion_models/flux3-image-klein-int8-convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 5.83,
      "phase": "denoise",
      "gated": true,
      "license": "FLUX Kommunity License"
    },
    {
      "repo": "black-forest-labs/flux-3-image-klein-comfy",
      "file": "text_encoders/qwen3vl_4b_int8_convrot.safetensors",
      "dir": "text_encoders",
      "gb": 4.86,
      "phase": "encode",
      "gated": true,
      "license": "FLUX Kommunity License"
    },
    {
      "repo": "black-forest-labs/flux-3-image-klein-comfy",
      "file": "vae/flux2-vae.safetensors",
      "dir": "vae",
      "gb": 0.34,
      "phase": "decode",
      "gated": true,
      "license": "FLUX Kommunity License"
    }
  ],
  "credits": [
    "FLUX 3 Image Klein and its prompt upsampler by Black Forest Labs (FLUX Kommunity License)"
  ],
  "test": {
    "scene": "a golden retriever sitting at a desk in front of three monitors, looking proud",
    "top": "WHEN THE TESTS",
    "bottom": "PASS FIRST TRY"
  }
}
